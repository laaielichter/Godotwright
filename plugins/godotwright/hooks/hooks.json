{
  "description": "Godotwright refuses Claude's file edits into paths a godotwright.json \"protect\" list (or the protect setting) keeps byte-identical, reviews every Godot file Claude edits and sends the errors back, adds lessons from real projects under Godot errors in command output, names review errors left open before Claude stops, and starts a session in a Godot project with what the project is (and, when a dream is due, how many dream proposals wait). Bash commands are not checked against protect. GODOTWRIGHT_HOOKS=0 turns them off.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" pre-edit",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" post-edit",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" post-bash",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" stop",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs\" session-start",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
