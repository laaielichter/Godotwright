{
  "mcpServers": {
    "godotwright": {
      "command": "npx",
      "args": [
        "-y",
        "godotwright@0.8.0",
        "mcp",
        "--tier",
        "premium"
      ],
      "env": {
        "GODOTWRIGHT_PROJECT": "${user_config.project}",
        "GODOT": "${user_config.godot}",
        "GODOTWRIGHT_PROTECT": "${user_config.protect}",
        "GODOTWRIGHT_TOOLS": "${user_config.tools}",
        "GODOTWRIGHT_READ_ONLY": "${user_config.read_only}",
        "GODOTWRIGHT_LEAN": "${user_config.lean}"
      }
    }
  }
}
