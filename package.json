{
  "name": "godotwright",
  "version": "0.0.1",
  "description": "MCP server and CLI that makes Claude Code, Codex and any coding agent better at Godot 4: offline Godot 4.7 API, project map, headless checks and an AAA GDScript review.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "godotwright": "dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "build:api": "node scripts/build-api.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "godot",
    "godot4",
    "godot-engine",
    "gdscript",
    "gamedev",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "ai-agent",
    "coding-agent",
    "linter",
    "code-review",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laaielichter/godotwright.git"
  },
  "homepage": "https://laaielichter.github.io/Godotwright/",
  "bugs": {
    "url": "https://github.com/laaielichter/godotwright/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
