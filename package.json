{
  "name": "godotwright",
  "version": "0.7.0",
  "mcpName": "io.github.laaielichter/godotwright",
  "description": "MCP server and CLI that makes Claude Code, Codex and any coding agent better at Godot 4: offline Godot 4.7 API, project map, headless checks, an AAA GDScript review, safe edits and renames, GUT/GdUnit4 tests, play-testing with input, screenshots, and 3D models built and checked from code.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "godotwright": "dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "build:api": "node scripts/build-api.ts",
    "build:library": "npm run build && node scripts/build-library.mjs",
    "render:library": "npm run build && node scripts/render-library.mjs --gallery && node scripts/render-library.mjs --site && node scripts/build-library-site.mjs",
    "prepare": "npm run build",
    "version": "node scripts/sync-version.mjs && git add server.json plugins/godotwright gemini-extension.json",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "godot",
    "godot4",
    "godot-engine",
    "gdscript",
    "gamedev",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "ai-agent",
    "coding-agent",
    "linter",
    "refactoring",
    "unit-testing",
    "gut",
    "gdunit4",
    "screenshot",
    "code-review",
    "cli",
    "gltf",
    "glb",
    "3d",
    "3d-models",
    "procedural-generation",
    "terrain",
    "model-generator",
    "blender-alternative",
    "godot-3d",
    "godot-mcp",
    "godot-ai",
    "claude",
    "claude-code-plugin",
    "cursor",
    "vscode",
    "copilot",
    "gemini-cli",
    "gemini-cli-extension",
    "ai",
    "llm",
    "agent-skills",
    "static-analysis",
    "gdscript-linter",
    "game-development",
    "godot-3-to-4",
    "migration",
    "headless",
    "github-action",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laaielichter/Godotwright.git"
  },
  "homepage": "https://laaielichter.github.io/Godotwright/",
  "bugs": {
    "url": "https://github.com/laaielichter/Godotwright/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
