    },
    {
     "name": "WheelFront_L",
     "at": [
      "$xr * 0.85",
      "$frontWheelRadius",
      "$zf"
     ],
     "children": [
      {
       "name": "Tread",
       "shape": "lathe",
       "material": "rubber",
       "rotate": [
        0,
        0,
        90
       ],
       "segments": 32,
       "profile": [
        [
         "$frontWheelRadius*0.52",
         "-0.3/2"
        ],
        [
         "$frontWheelRadius*0.9",
         "-0.3/2"
        ],
        [
         "$frontWheelRadius",
         "-0.3*0.34"
        ],
        [
         "$frontWheelRadius",
         "0.3*0.34"
        ],
        [
         "$frontWheelRadius*0.9",
         "0.3/2"
        ],
        [
         "$frontWheelRadius*0.52",
         "0.3/2"
        ]
       ]
      },
      {
       "name": "Rim",
       "shape": "lathe",
       "material": "metal",
       "rotate": [
        0,
        0,
        90
       ],
       "segments": 32,
       "profile": [
        [
         0,
         "-0.3*0.53"
        ],
        [
         "$frontWheelRadius*0.53",
         "-0.3*0.53"
        ],
        [
         "$frontWheelRadius*0.47",
         0
        ],
        [
         "$frontWheelRadius*0.53",
         "0.3*0.53"
        ],
        [
         0,
         "0.3*0.53"
        ]
       ]
      }
     ],
     "mirror": "WheelFront_R"
    },
    {
     "name": "Hitch",
     "at": [
      0,
      "$hood * 0.5 - 0.1",
      "$zr - 0.9"
     ],
     "children": [
      {
       "name": "Bar",
       "shape": "box",
       "material": "metal",
       "size": [
        0.8,
        0.14,
        0.45
       ],
       "at": [
        0,
        0.07,
        -0.22
       ]
      }
     ]
    }
   ]
  }
 ]
}
