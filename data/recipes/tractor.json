{
 "version": 1,
 "name": "tractor",
 "archetype": "vehicle.wheeled.tractor",
 "description": "A farm tractor: hood, cab, big rear and small front wheels with their pivot at the hub, fenders, exhaust and a hitch on its hinge.",
 "params": [
  {
   "name": "rearWheelRadius",
   "type": "number",
   "default": 0.85,
   "min": 0.6,
   "max": 1.1,
   "description": "Radius of the large rear wheels."
  },
  {
   "name": "frontWheelRadius",
   "type": "number",
   "default": 0.55,
   "min": 0.35,
   "max": 0.7,
   "description": "Radius of the small front wheels."
  },
  {
   "name": "track",
   "type": "number",
   "default": 1.9,
   "min": 1.5,
   "max": 2.4,
   "description": "Distance between the left and right wheels."
  },
  {
   "name": "wheelbase",
   "type": "number",
   "default": 2.6,
   "min": 2.0,
   "max": 3.2,
   "description": "Distance between the axles."
  }
 ],
 "materials": {
  "tractor_paint": {
   "color": [
    0.1,
    0.35,
    0.12
   ],
   "metallic": 0.1,
   "roughness": 0.4
  }
 },
 "nodes": [
  {
   "name": "Tractor",
   "material": "tractor_paint",
   "vars": {
    "zf": "$wheelbase * 0.6",
    "zr": "-$wheelbase * 0.4",
    "xr": "$track / 2",
    "hood": "$rearWheelRadius * 2 + 0.05"
   },
   "children": [
    {
     "name": "Body",
     "shape": "loft",
     "sections": [
      {
       "z": "$zr + 0.5",
       "superellipse": {
        "width": 0.95,
        "height": 0.9,
        "n": 4,
        "count": 32,
        "cy": "$hood * 0.6 + 0.35"
       }
      },
      {
       "z": "$zf * 0.5",
       "superellipse": {
        "width": 0.9,
        "height": 0.85,
        "n": 4,
        "count": 32,
        "cy": "$hood * 0.6 + 0.3"
       }
      },
      {
       "z": "$zf + 0.65",
       "superellipse": {
        "width": 0.8,
        "height": 0.7,
        "n": 4,
        "count": 32,
        "cy": "$hood * 0.6 + 0.15"
       }
      }
     ]
    },
    {
     "name": "Frame",
     "shape": "box",
     "material": "metal",
     "size": [
      0.6,
      0.3,
      "$wheelbase + 1.2"
     ],
     "at": [
      0,
      "$hood * 0.5",
      "($zf + $zr) / 2 + 0.15"
     ]
    },
    {
     "name": "Cab",
     "at": [
      0,
      "$hood + 0.1",
      "$zr - 0.1"
     ],
     "children": [
      {
       "name": "Windows",
       "shape": "box",
       "material": "glass",
       "size": [
        1.3,
        1.3,
        1.4
       ],
       "at": [
        0,
        0.65,
        0
       ]
      },
      {
       "name": "Roof",
       "shape": "box",
       "size": [
        1.5,
        0.1,
        1.6
       ],
       "at": [
        0,
        1.35,
        0
       ]
      },
      {
       "name": "Floor",
       "shape": "box",
       "size": [
        1.4,
        0.1,
        1.5
       ],
       "at": [
        0,
        0,
        0
       ]
      }
     ]
    },
    {
     "name": "Exhaust",
     "shape": "lathe",
     "material": "metal",
     "segments": 16,
     "profile": [
      [
       0.05,
       0
      ],
      [
       0.05,
       0.9
      ],
      [
       0.07,
       0.9
      ]
     ],
     "at": [
      0.28,
      "$hood * 0.6 + 0.65",
      "$zf * 0.8"
     ]
    },
    {
     "name": "Fender_L",
     "shape": "box",
     "size": [
      0.62,
      0.07,
      1.4
     ],
     "at": [
      "$xr",
      "$rearWheelRadius * 2 + 0.2",
      "$zr"
     ],
     "mirror": "Fender_R"
    },
    {
