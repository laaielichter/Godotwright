         "-0.5/2"
        ],
        [
         "$rearWheelRadius",
         "-0.5*0.34"
        ],
        [
         "$rearWheelRadius",
         "0.5*0.34"
        ],
        [
         "$rearWheelRadius*0.9",
         "0.5/2"
        ],
        [
         "$rearWheelRadius*0.52",
         "0.5/2"
        ]
       ]
      },
      {
       "name": "Rim",
       "shape": "lathe",
       "material": "metal",
       "rotate": [
        0,
        0,
        90
       ],
       "segments": 40,
       "profile": [
        [
         0,
         "-0.5*0.53"
        ],
        [
         "$rearWheelRadius*0.53",
         "-0.5*0.53"
        ],
        [
         "$rearWheelRadius*0.47",
         0
        ],
        [
         "$rearWheelRadius*0.53",
