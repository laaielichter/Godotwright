  {
   "name": "length",
   "type": "number",
   "default": 20,
   "min": 15,
   "max": 27,
   "description": "Body length in metres."
  },
  {
   "name": "width",
   "type": "number",
   "default": 2.9,
   "min": 2.8,
   "max": 3.15,
   "description": "Body width in metres."
  },
  {
   "name": "height",
   "type": "number",
   "default": 4.0,
   "min": 3.6,
   "max": 4.4,
   "description": "Roof height above the rail."
  },
  {
   "name": "wheelRadius",
   "type": "number",
   "default": 0.46,
   "min": 0.4,
   "max": 0.55,
   "description": "Wheel radius."
  }
 ],
