{
 "version": 1,
 "name": "light-aircraft",
 "archetype": "aircraft.fixed-wing.light-aircraft",
 "description": "A high-wing single-engine propeller aeroplane: tapered fuselage with cabin glass, straight wings with ailerons, tailplane with elevators, fin with rudder, a spinning propeller and fixed tricycle landing gear.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 8.3,
   "min": 6,
   "max": 10,
   "description": "Fuselage length in metres (a Cessna 172 is about 8.3)."
  },
  {
   "name": "wingSpan",
   "type": "number",
   "default": 11,
   "min": 8,
   "max": 13,
   "description": "Wingspan, tip to tip."
  }
 ],
 "materials": {
  "plane_white": {
   "color": [
    0.92,
    0.92,
    0.9
   ],
   "metallic": 0.2,
   "roughness": 0.35
  },
  "plane_stripe": {
   "color": [
    0.7,
    0.1,
    0.1
   ],
   "metallic": 0.2,
   "roughness": 0.4
  }
 },
 "nodes": [
  {
   "name": "LightAircraft",
   "material": "plane_white",
   "vars": {
    "d": 1.25,
    "c": "1.0 + 0.55",
    "h": "$wingSpan / 2 - 0.5",
    "rc": "$length * 0.14",
    "tc": "$length * 0.09",
    "L2": "$length / 2",
    "legN": "$c - 0.4 - 0.2",
    "legM": "($c - 0.45 - 0.22) / cos(rad(18))"
   },
   "children": [
    {
     "name": "Fuselage",
     "shape": "loft",
     "sections": [
      {
       "z": "$L2",
       "superellipse": {
        "width": 0.7,
        "height": 0.8,
        "n": 2.5,
        "count": 28,
        "cy": "$c - 0.05"
       }
      },
      {
       "z": "$L2 - 0.6",
       "superellipse": {
        "width": 1.1,
        "height": 1.2,
        "n": 2.5,
        "count": 28,
        "cy": "$c"
       }
      },
      {
       "z": "$L2 - 2.2",
       "superellipse": {
        "width": "$d",
        "height": 1.5,
        "n": 2.5,
        "count": 28,
        "cy": "$c + 0.1"
       }
      },
      {
       "z": "-$L2 + 3.2",
       "superellipse": {
        "width": 1.0,
        "height": 1.25,
        "n": 2.5,
        "count": 28,
        "cy": "$c + 0.15"
       }
      },
      {
       "z": "-$L2 + 0.8",
       "superellipse": {
        "width": 0.4,
        "height": 0.55,
        "n": 2.5,
        "count": 28,
        "cy": "$c + 0.25"
       }
      },
      {
       "z": "-$L2",
       "superellipse": {
        "width": 0.1,
        "height": 0.2,
        "n": 2.5,
        "count": 28,
        "cy": "$c + 0.3"
       }
      }
     ]
    },
    {
     "name": "Cabin",
     "shape": "ellipsoid",
     "material": "glass",
     "radii": [
      0.6,
      0.45,
      1.3
     ],
     "at": [
      0,
      "$c + 0.55",
      "$L2 - 3.0"
     ]
    },
    {
     "name": "WingLeft",
     "at": [
      0.35,
      "$c + 0.6",
      "$L2 - 2.9"
     ],
     "rotate": [
      0,
      90,
      1.5
     ],
     "children": [
      {
       "name": "Skin",
       "shape": "loft",
       "sections": [
        {
         "z": 0,
         "superellipse": {
          "width": "$rc",
          "height": "($rc) * 0.12",
          "n": 2.5,
          "count": 24,
          "cy": 0
         }
        },
        {
         "z": "$h",
         "superellipse": {
          "width": "$tc",
          "height": "($tc) * 0.12 * 0.7",
          "n": 2.5,
          "count": 24,
          "cy": 0,
          "cx": "(0) + (($rc) - ($tc)) * 0.25"
         }
        }
       ]
      }
     ],
     "mirror": "WingRight"
    },
    {
     "name": "Aileron_L",
     "at": [
      "$wingSpan * 0.18 + 0.35",
      "$c + 0.6",
      "$L2 - 2.9 - $rc * 0.5"
     ],
     "mirror": "Aileron_R",
     "children": [
      {
       "name": "Flap",
       "shape": "box",
       "material": "plane_stripe",
       "size": [
        "$wingSpan * 0.2",
        0.03,
        "$rc * 0.28"
       ],
       "offset": [
        "$wingSpan * 0.1",
        0,
        "-$rc * 0.14"
       ]
      }
     ]
    },
    {
     "name": "Stabilizer",
     "shape": "loft",
     "sections": [
      {
       "z": 0,
       "superellipse": {
        "width": 1.0,
        "height": 0.07,
        "n": 2.5,
        "count": 20,
        "cy": 0
       }
      },
      {
       "z": 1.7,
       "superellipse": {
        "width": 0.55,
        "height": 0.05,
        "n": 2.5,
        "count": 20,
        "cy": 0,
        "cx": 0.2
       }
      }
     ],
     "at": [
      0,
      "$c + 0.3",
      "-$L2 + 0.85"
     ],
     "rotate": [
      0,
      90,
      0
     ]
    },
    {
     "name": "Elevator_L",
     "at": [
      0.2,
      "$c + 0.3",
      "-$L2 + 0.35"
     ],
     "mirror": "Elevator_R",
     "children": [
      {
       "name": "Flap",
       "shape": "box",
       "material": "plane_stripe",
       "size": [
        1.4,
        0.04,
        0.3
       ],
       "offset": [
        0.75,
        0,
        -0.15
       ]
      }
     ]
    },
    {
     "name": "Fin",
     "shape": "loft",
     "sections": [
      {
       "z": "-$L2 + 1.5",
       "superellipse": {
        "width": 0.08,
        "height": 0.3,
        "n": 2.5,
        "count": 16,
        "cy": "$c + 0.45"
       }
      },
      {
       "z": "-$L2 + 0.7",
       "superellipse": {
        "width": 0.06,
        "height": 1.0,
        "n": 2.5,
        "count": 16,
        "cy": "$c + 0.9"
       }
      },
      {
       "z": "-$L2 + 0.45",
       "superellipse": {
        "width": 0.05,
        "height": 1.15,
        "n": 2.5,
        "count": 16,
        "cy": "$c + 1.0"
       }
      }
     ]
    },
    {
     "name": "Rudder",
     "at": [
      0,
      "$c + 0.35",
      "-$L2 + 0.4"
     ],
     "children": [
      {
       "name": "Flap",
       "shape": "box",
       "material": "plane_stripe",
       "size": [
        0.04,
        1.0,
        0.3
       ],
       "offset": [
        0,
        0.5,
        -0.15
       ]
      }
     ]
    },
    {
     "name": "Propeller",
     "at": [
      0,
      "$c - 0.05",
      "$L2 + 0.1"
     ],
     "children": [
      {
       "name": "Spinner",
       "shape": "ellipsoid",
       "material": "plane_stripe",
       "radii": [
        0.13,
        0.13,
        0.2
       ],
       "at": [
        0,
        0,
        0.05
       ]
      },
      {
       "name": "Blade",
       "shape": "box",
       "material": "metal",
       "size": [
        0.12,
        1.0,
        0.03
       ],
       "offset": [
        0,
        0.55,
        0
       ],
       "repeat": {
        "count": 2,
        "around": "z"
       }
      }
     ]
    },
    {
     "name": "LandingGear_Nose",
     "material": "metal",
     "at": [
      0,
      "$c - 0.4",
      "$L2 - 1.0"
     ],
     "children": [
      {
       "name": "Leg",
       "shape": "box",
       "size": [
        0.07,
        "$legN",
        0.07
       ],
       "at": [
        0,
        "-$legN / 2",
        0
       ]
      },
      {
       "name": "Foot",
       "shape": "cylinder",
       "material": "rubber",
       "rotate": [
        0,
        0,
        90
       ],
       "radius": 0.2,
       "height": 0.12,
       "segments": 20,
       "at": [
        0,
        "-$legN",
        0
       ]
      }
     ]
    },
    {
     "name": "LandingGear_Main_L",
     "material": "metal",
     "at": [
      0.5,
      "$c - 0.45",
      "$L2 - 3.0"
     ],
     "mirror": "LandingGear_Main_R",
     "children": [
      {
       "name": "Leg",
       "shape": "box",
       "size": [
        0.08,
        "$legM",
        0.08
       ],
       "offset": [
        0,
        "-$legM / 2",
        0
       ],
       "rotate": [
        0,
        0,
        18
       ]
      },
      {
       "name": "Foot",
       "shape": "cylinder",
       "material": "rubber",
       "rotate": [
        0,
        0,
        90
       ],
       "radius": 0.22,
       "height": 0.14,
       "segments": 20,
       "at": [
        "$legM * sin(rad(18))",
        "-$legM * cos(rad(18))",
        0
       ]
      }
     ]
    }
   ]
  }
 ]
}
