{
 "version": 1,
 "name": "tree",
 "archetype": "plant.tree.broadleaf",
 "description": "A broadleaf tree: a flared, tapering trunk, ringed branches and a crown of blobs of foliage.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 9,
   "min": 4,
   "max": 30,
   "description": "Total height in metres."
  },
  {
   "name": "crownRadius",
   "type": "number",
   "default": 3.2,
   "min": 1.5,
   "max": 10,
   "description": "Radius of the crown."
  },
  {
   "name": "trunkRadius",
   "type": "number",
   "default": 0.28,
   "min": 0.1,
   "max": 1.0,
   "description": "Trunk radius at head height."
  },
  {
   "name": "branches",
   "type": "integer",
   "default": 5,
   "min": 3,
   "max": 8,
   "description": "Number of branches."
  }
 ],
 "nodes": [
  {
   "name": "Tree",
   "material": "bark",
   "vars": {
    "ry": "min($crownRadius * 0.85, $height * 0.38)",
    "cr": "$crownRadius",
    "tr": "$trunkRadius"
   },
   "children": [
    {
     "name": "Trunk",
     "shape": "lathe",
     "segments": 16,
     "profile": [
      [
       "$tr * 1.6",
       0
      ],
      [
       "$tr * 1.2",
       "($height - $ry) * 0.06"
      ],
      [
       "$tr * 0.95",
       "($height - $ry) * 0.45"
      ],
      [
       "$tr * 0.6",
       "$height - $ry"
      ]
     ]
    },
    {
     "name": "Branch",
     "shape": "lathe",
     "segments": 8,
     "rotate": [
      0,
      0,
      -38
     ],
     "at": [
      0,
      "$height * 0.42",
      0
     ],
     "repeat": {
      "count": "$branches",
      "around": "y"
     },
     "profile": [
      [
       "$tr * 0.5",
       0
      ],
      [
       "$tr * 0.18",
       "$cr * 1.2"
      ]
     ]
    },
    {
     "name": "Crown",
     "material": "leaf",
     "at": [
      0,
      "$height - $ry",
      0
     ],
     "children": [
      {
       "name": "Top",
       "shape": "ellipsoid",
       "radii": [
        "$cr * 0.8",
        "$ry",
        "$cr * 0.8"
       ],
       "segments": 20
      },
      {
       "name": "Blob",
       "shape": "ellipsoid",
       "radii": [
        "$cr * 0.6",
        "$ry * 0.78",
        "$cr * 0.6"
       ],
       "segments": 16,
       "at": [
        "$cr * 0.55",
        "-$ry * 0.12",
        0
       ],
       "repeat": {
        "count": 5,
        "around": "y"
       }
      }
     ]
    }
   ]
  }
 ]
}
