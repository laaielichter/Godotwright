{
 "version": 1,
 "name": "fighter",
 "archetype": "aircraft.fixed-wing.fighter",
 "description": "A twin-fin jet fighter: a long blended fuselage with canopy and intake, swept trapezoid wings with ailerons, all-moving tailplanes, canted fins with a rudder, an engine nozzle and retractable tricycle landing gear.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 15,
   "min": 10,
   "max": 20,
   "description": "Fuselage length in metres."
  },
  {
   "name": "wingSpan",
   "type": "number",
   "default": 10.5,
   "min": 7,
   "max": 14,
   "description": "Wingspan, tip to tip."
  }
 ],
 "materials": {
  "fighter_grey": {
   "color": [
    0.45,
    0.48,
    0.52
   ],
   "metallic": 0.4,
   "roughness": 0.45
  }
 },
 "nodes": [
  {
   "name": "Fighter",
   "material": "fighter_grey",
   "vars": {
    "L2": "$length / 2",
    "c": 1.9,
    "h": "$wingSpan / 2 - 0.6",
    "rc": "$length * 0.3",
    "tc": "$length * 0.07",
    "legN": "$c - 0.5 - 0.25",
    "legM": "$c - 0.3 - 0.3"
   },
   "children": [
    {
     "name": "Fuselage",
     "shape": "loft",
     "sections": [
      {
       "z": "$L2",
       "superellipse": {
        "width": 0.1,
        "height": 0.1,
        "n": 2.2,
        "count": 28,
        "cy": "$c"
       }
      },
      {
       "z": "$L2 - 1.2",
       "superellipse": {
        "width": 0.7,
        "height": 0.7,
        "n": 2.2,
        "count": 28,
        "cy": "$c + 0.05"
       }
      },
      {
       "z": "$L2 - 4.0",
       "superellipse": {
        "width": 1.5,
        "height": 1.4,
        "n": 2.5,
        "count": 28,
        "cy": "$c + 0.1"
       }
      },
      {
       "z": "-$L2 + 5.0",
       "superellipse": {
        "width": 1.7,
        "height": 1.3,
        "n": 2.5,
        "count": 28,
        "cy": "$c"
       }
      },
      {
       "z": "-$L2 + 1.0",
       "superellipse": {
        "width": 1.3,
        "height": 1.1,
        "n": 2.5,
        "count": 28,
        "cy": "$c"
       }
      },
      {
       "z": "-$L2",
       "superellipse": {
        "width": 1.0,
        "height": 1.0,
        "n": 2.2,
        "count": 28,
        "cy": "$c"
       }
      }
     ]
    },
    {
     "name": "Canopy",
     "shape": "ellipsoid",
     "material": "glass",
     "radii": [
      0.38,
      0.35,
      1.7
     ],
     "at": [
      0,
      "$c + 0.35",
      "$L2 - 5.9"
     ],
     "offset": [
      0,
      0.35,
      1.7
     ]
    },
    {
     "name": "Intake_L",
     "shape": "box",
     "size": [
      0.4,
      0.55,
      1.6
     ],
     "at": [
      0.85,
      "$c - 0.15",
      "$L2 - 4.2"
     ],
     "mirror": "Intake_R"
    },
    {
     "name": "WingLeft",
     "at": [
      0.55,
      "$c - 0.1",
      "-$L2 + 5.8"
     ],
     "rotate": [
      0,
      90,
      0
     ],
     "children": [
      {
       "name": "Skin",
       "shape": "loft",
       "sections": [
        {
         "z": 0,
         "superellipse": {
          "width": "$rc",
          "height": "($rc) * 0.05",
          "n": 2.5,
          "count": 24,
          "cy": 0
         }
        },
        {
         "z": "$h",
         "superellipse": {
          "width": "$tc",
          "height": "($tc) * 0.05 * 0.7",
          "n": 2.5,
          "count": 24,
          "cy": 0,
          "cx": "($length * 0.17) + (($rc) - ($tc)) * 0.25"
         }
        }
       ]
      }
     ],
     "mirror": "WingRight"
    },
    {
     "name": "Aileron_L",
     "at": [
      "$h * 0.6 + 0.55",
      "$c - 0.1",
      "-$L2 + 5.8 - $rc * 0.5 - $length * 0.17 * 0.6 + 0.2"
     ],
     "mirror": "Aileron_R",
     "children": [
      {
       "name": "Flap",
       "shape": "box",
       "material": "metal",
       "size": [
        "$h * 0.3",
        0.04,
        0.4
       ],
       "offset": [
        "$h * 0.15",
        0,
        -0.2
       ]
      }
     ]
    },
    {
     "name": "Elevator_L",
     "at": [
      0.7,
      "$c - 0.05",
      "-$L2 + 0.9"
     ],
     "mirror": "Elevator_R",
     "rotate": [
      0,
      0,
      0
     ],
     "children": [
      {
       "name": "Plate",
       "shape": "loft",
       "sections": [
        {
         "z": 0,
         "superellipse": {
          "width": "$length * 0.14",
          "height": 0.05,
          "n": 2.5,
          "count": 20,
          "cy": 0
         }
        },
        {
         "z": "$wingSpan * 0.2",
         "superellipse": {
          "width": "$length * 0.06",
          "height": 0.03,
          "n": 2.5,
          "count": 20,
          "cy": 0,
          "cx": "$length * 0.05"
         }
        }
       ],
       "rotate": [
        0,
        90,
        0
       ]
      }
     ]
    },
    {
     "name": "Fin_L",
     "shape": "loft",
     "sections": [
      {
       "z": "-$L2 + 3.6",
       "superellipse": {
        "width": 0.07,
        "height": 0.6,
        "n": 2.5,
        "count": 16,
        "cy": "$c + 0.75"
       }
      },
      {
       "z": "-$L2 + 1.8",
       "superellipse": {
        "width": 0.06,
        "height": 1.7,
        "n": 2.5,
        "count": 16,
        "cy": "$c + 1.4"
       }
      },
      {
       "z": "-$L2 + 0.8",
       "superellipse": {
        "width": 0.05,
        "height": 1.8,
        "n": 2.5,
        "count": 16,
        "cy": "$c + 1.5"
       }
      }
     ],
     "at": [
      0.55,
      0,
      0
     ],
     "mirror": "Fin_R"
    },
    {
     "name": "Nozzle",
     "shape": "lathe",
     "material": "metal",
     "segments": 24,
     "rotate": [
      90,
      0,
      0
     ],
     "at": [
      0,
      "$c",
      "-$L2 - 0.2"
     ],
     "profile": [
      [
       0.45,
       0.6
      ],
      [
       0.5,
       0.3
      ],
      [
       0.42,
       -0.2
      ],
      [
       0.35,
       -0.2
      ],
      [
       0.35,
       0.6
      ]
     ]
    },
    {
     "name": "LandingGear_Nose",
     "material": "metal",
     "at": [
      0,
      "$c - 0.5",
      "$L2 - 3.2"
     ],
     "children": [
      {
       "name": "Leg",
       "shape": "box",
       "size": [
        0.08,
        "$legN",
        0.08
       ],
       "at": [
        0,
        "-$legN / 2",
        0
       ]
      },
      {
       "name": "Foot",
       "shape": "cylinder",
       "material": "rubber",
       "rotate": [
        0,
        0,
        90
       ],
       "radius": 0.25,
       "height": 0.14,
       "segments": 20,
       "at": [
        0,
        "-$legN",
        0
       ]
      }
     ]
    },
    {
     "name": "LandingGear_Main_L",
     "material": "metal",
     "at": [
      0.7,
      "$c - 0.3",
      "-$L2 + 6.0"
     ],
     "mirror": "LandingGear_Main_R",
     "children": [
      {
       "name": "Leg",
       "shape": "box",
       "size": [
        0.1,
        "$legM",
        0.1
       ],
       "at": [
        0,
        "-$legM / 2",
        0
       ]
      },
      {
       "name": "Foot",
       "shape": "cylinder",
       "material": "rubber",
       "rotate": [
        0,
        0,
        90
       ],
       "radius": 0.3,
       "height": 0.2,
       "segments": 20,
       "at": [
        0,
        "-$legM",
        0
       ]
      }
     ]
    }
   ]
  }
 ]
}
