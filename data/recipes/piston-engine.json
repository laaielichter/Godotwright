{
 "version": 1,
 "name": "piston-engine",
 "archetype": "machine.piston-engine",
 "description": "An inline piston engine: a crankcase block with an oil pan, a row of cylinders with a piston in each, a cylinder head and cover, a crankshaft along the length and a flywheel at the rear. The pistons and the crankshaft are separate nodes so they can move.",
 "params": [
  {
   "name": "cylinders",
   "type": "integer",
   "default": 4,
   "min": 2,
   "max": 8,
   "description": "Number of cylinders in line."
  },
  {
   "name": "bore",
   "type": "number",
   "default": 0.09,
   "min": 0.06,
   "max": 0.13,
   "description": "Cylinder bore diameter in metres."
  }
 ],
 "materials": {
  "engine_block": {
   "color": [
    0.35,
    0.36,
    0.4
   ],
   "metallic": 0.7,
   "roughness": 0.5
  },
  "engine_head": {
   "color": [
    0.6,
    0.6,
    0.62
   ],
   "metallic": 0.8,
   "roughness": 0.35
  }
 },
 "nodes": [
  {
   "name": "PistonEngine",
   "material": "engine_block",
   "vars": {
    "pitch": "$bore * 1.25",
    "len": "$cylinders * $bore * 1.25 + 0.1",
    "yb": 0.22
   },
   "children": [
    {
     "name": "Block",
     "shape": "box",
     "size": [
      "$bore * 3.2",
      "$yb",
      "$len"
     ],
     "at": [
      0,
      "$yb / 2 + 0.06",
      0
     ]
    },
    {
     "name": "Pan",
     "shape": "box",
     "material": "metal",
     "size": [
      "$bore * 2.6",
      0.07,
      "$len * 0.9"
     ],
     "at": [
      0,
      0.035,
      0
     ]
    },
    {
     "name": "Cylinder_{i}",
     "shape": "cylinder",
     "material": "engine_head",
     "radius": "$bore * 0.62",
     "height": 0.1,
     "segments": 20,
     "at": [
      0,
      "$yb + 0.06 + 0.05",
      "$len / 2 - 0.05 - $pitch / 2"
     ],
     "repeat": {
      "count": "$cylinders",
      "step": [
       0,
       0,
       "-$pitch"
      ]
     }
    },
    {
     "name": "Piston_{i}",
     "shape": "cylinder",
     "material": "metal",
     "radius": "$bore * 0.45",
     "height": 0.07,
     "segments": 16,
     "at": [
      0,
      "$yb + 0.06 + 0.12",
      "$len / 2 - 0.05 - $pitch / 2"
     ],
     "repeat": {
      "count": "$cylinders",
      "step": [
       0,
       0,
       "-$pitch"
      ]
     }
    },
    {
     "name": "Head",
     "shape": "box",
     "material": "engine_head",
     "size": [
      "$bore * 1.5",
      0.08,
      "$len - 0.04"
     ],
     "at": [
      0,
      "$yb + 0.06 + 0.2",
      0
     ]
    },
    {
     "name": "Crankshaft",
     "shape": "cylinder",
     "material": "metal",
     "rotate": [
      90,
      0,
      0
     ],
     "radius": "$bore * 0.18",
     "height": "$len + 0.2",
     "segments": 14,
     "at": [
      0,
      "$yb * 0.4 + 0.06",
      0
     ]
    },
    {
     "name": "Flywheel",
     "shape": "cylinder",
     "material": "metal",
     "rotate": [
      90,
      0,
      0
     ],
     "radius": "$bore * 1.3",
     "height": 0.05,
     "segments": 28,
     "at": [
      0,
      "$yb * 0.4 + 0.06",
      "-$len / 2 - 0.12"
     ]
    }
   ]
  }
 ]
}
