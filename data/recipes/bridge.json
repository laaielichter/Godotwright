   "max": 25,
   "description": "Deck width in metres."
  },
  {
   "name": "height",
   "type": "number",
   "default": 8,
   "min": 3,
   "max": 30,
   "description": "Height of the deck surface above the ground."
  },
  {
   "name": "piers",
   "type": "integer",
   "default": 3,
   "min": 1,
   "max": 10,
