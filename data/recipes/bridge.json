{
 "version": 1,
 "name": "bridge",
 "archetype": "infrastructure.bridge",
 "description": "A girder road bridge: a deck with a railing on each side, a row of piers under it and an abutment at each end. The deck is the walking and driving surface and the piers stand on the ground.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 60,
   "min": 10,
   "max": 300,
   "description": "Length along z in metres."
  },
  {
   "name": "width",
   "type": "number",
   "default": 10,
   "min": 5,
   "max": 25,
   "description": "Deck width in metres."
  },
  {
   "name": "height",
   "type": "number",
   "default": 8,
   "min": 3,
   "max": 30,
   "description": "Height of the deck surface above the ground."
  },
  {
   "name": "piers",
   "type": "integer",
   "default": 3,
   "min": 1,
   "max": 10,
   "description": "Number of piers between the abutments."
  }
 ],
 "materials": {
  "bridge_concrete": {
   "color": [
    0.62,
    0.62,
    0.6
   ],
   "metallic": 0.05,
   "roughness": 0.8
  }
 },
 "nodes": [
  {
   "name": "Bridge",
   "material": "bridge_concrete",
   "vars": {
    "L2": "$length / 2",
    "gird": 1.2
   },
   "children": [
    {
     "name": "Deck",
     "shape": "box",
     "size": [
      "$width",
      "$gird",
      "$length"
     ],
     "at": [
      0,
      "$height - $gird / 2",
      0
     ]
    },
    {
     "name": "Surface",
     "shape": "box",
     "material": "asphalt",
     "size": [
      "$width - 1.4",
      0.1,
      "$length"
     ],
     "at": [
      0,
      "$height + 0.05",
      0
     ]
    },
    {
     "name": "Railing_L",
     "shape": "box",
     "material": "metal",
     "size": [
      0.12,
      1.0,
      "$length"
     ],
     "at": [
      "$width / 2 - 0.1",
      "$height + 0.5",
      0
     ],
     "mirror": "Railing_R"
    },
    {
     "name": "Pier_{i}",
     "shape": "box",
     "size": [
      "$width * 0.4",
      "$height - $gird",
      1.4
     ],
     "at": [
      0,
      "($height - $gird) / 2",
      "-$L2 + ($i + 1) * $length / ($piers + 1)"
     ],
     "repeat": {
      "count": "$piers",
      "step": [
       0,
       0,
       0
      ]
     }
    },
    {
     "name": "Abutment_F",
     "shape": "box",
     "size": [
      "$width",
      "$height - $gird",
      3
     ],
     "at": [
      0,
      "($height - $gird) / 2",
      "$L2 - 1.5"
     ]
    },
    {
     "name": "Abutment_B",
     "shape": "box",
     "size": [
      "$width",
      "$height - $gird",
      3
     ],
     "at": [
      0,
      "($height - $gird) / 2",
      "-$L2 + 1.5"
     ]
    }
   ]
  }
 ]
}
