  {
   "name": "length",
   "type": "number",
   "default": 1.75,
   "min": 1.5,
   "max": 2.0,
   "description": "Overall length in metres."
  },
  {
   "name": "wheelRadius",
   "type": "number",
   "default": 0.34,
   "min": 0.3,
   "max": 0.37,
   "description": "Wheel radius including the tyre (28 inch is about 0.34)."
