{
 "version": 1,
 "name": "bicycle",
 "archetype": "vehicle.wheeled.bicycle",
 "description": "A city bicycle: a diamond frame of round tubes, a steering fork with handlebar that carries the front wheel, a rear wheel with spokes, a saddle and a crank with pedals.",
