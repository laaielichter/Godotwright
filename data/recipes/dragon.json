        "$L * 0.03",
        "$L * 0.10"
       ]
      },
      {
       "name": "Jaw",
       "at": [
        0,
        "$L * 0.012",
        "$L * 0.05"
       ],
       "children": [
        {
         "name": "Mandible",
         "shape": "box",
         "size": [
          "$L * 0.045",
          "$L * 0.014",
          "$L * 0.1"
         ],
         "offset": [
          0,
          "-$L * 0.007",
          "$L * 0.05"
         ]
        }
       ]
      },
      {
       "name": "Horn_L",
       "shape": "lathe",
       "material": "horn",
       "segments": 8,
       "at": [
        "$L * 0.02",
        "$L * 0.05",
        "$L * 0.05"
       ],
       "rotate": [
        -55,
        0,
        0
       ],
       "profile": [
