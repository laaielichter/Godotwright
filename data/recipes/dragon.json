          "width": "$L * 0.0707",
          "height": "$L * 0.0636",
          "n": 2.2,
          "count": 16,
          "cy": "-$L * 0.0318"
         }
        },
        {
         "z": "-$L * 0.210",
         "superellipse": {
          "width": "$L * 0.0560",
          "height": "$L * 0.0504",
          "n": 2.2,
          "count": 16,
          "cy": "-$L * 0.0252"
         }
        },
        {
         "z": "-$L * 0.280",
         "superellipse": {
          "width": "$L * 0.0413",
          "height": "$L * 0.0372",
          "n": 2.2,
          "count": 16,
          "cy": "-$L * 0.0186"
         }
        },
        {
         "z": "-$L * 0.350",
         "superellipse": {
          "width": "$L * 0.0267",
          "height": "$L * 0.0240",
          "n": 2.2,
          "count": 16,
          "cy": "-$L * 0.0120"
         }
        },
        {
         "z": "-$L * 0.420",
         "superellipse": {
          "width": "$L * 0.0120",
          "height": "$L * 0.0108",
          "n": 2.2,
          "count": 16,
          "cy": "-$L * 0.0054"
         }
        }
       ]
      }
     ]
    },
    {
     "name": "Wing_L",
     "at": [
      "$L * 0.05",
      "$by + $L * 0.06",
      "$L * 0.08"
     ],
     "rotate": [
      0,
      0,
      18
     ],
     "mirror": "Wing_R",
     "children": [
      {
       "name": "Membrane",
       "shape": "extrude",
       "material": "membrane",
       "y0": "-$L * 0.003",
       "y1": "$L * 0.003",
       "plan": [
        [
         0,
         0
        ],
        [
         "$sp",
         "$L * 0.04"
        ],
        [
         "$sp * 0.75",
         "-$L * 0.18"
        ],
        [
         "$sp * 0.45",
         "-$L * 0.12"
        ],
        [
         "$sp * 0.2",
         "-$L * 0.16"
        ],
        [
         0,
         "-$L * 0.1"
        ]
       ]
      },
      {
       "name": "Arm",
       "shape": "cylinder",
       "axis": "x",
       "radius": "$L * 0.008",
       "height": "$sp",
       "segments": 8,
       "offset": [
        "$sp / 2",
        0,
        "$L * 0.02"
       ]
      }
     ]
    }
   ]
  }
 ]
}
