{
 "version": 1,
 "name": "dragon",
 "archetype": "creature.dragon",
 "description": "A four-legged dragon: a long body, a neck rising to a horned head with a hinged jaw, two wings hinged at the shoulders, four legs and a long tapering tail; every moving part a node with its pivot at its joint. Head towards +Z, feet on y = 0.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 12,
   "min": 4,
   "max": 30,
   "description": "Length from the nose to the tip of the tail, in metres."
  },
  {
   "name": "wingSpan",
   "type": "number",
   "default": 0.6,
   "min": 0.35,
   "max": 0.9,
   "description": "Length of one wing as a fraction of the length."
  }
 ],
 "materials": {
  "scales": {
   "color": [
    0.18,
    0.35,
    0.2,
    1
   ],
   "metallic": 0.1,
   "roughness": 0.55
  },
  "membrane": {
   "color": [
    0.35,
    0.2,
    0.15,
    1
   ],
   "metallic": 0,
   "roughness": 0.7
  },
  "horn": {
   "color": [
    0.85,
    0.8,
    0.68,
    1
   ],
   "metallic": 0,
   "roughness": 0.5
  }
 },
 "nodes": [
  {
   "name": "Dragon",
   "material": "scales",
   "vars": {
    "L": "$length",
    "lg": "$length * 0.1",
    "by": "$length * 0.18",
    "rl": "$length * 0.03",
    "sp": "$length * $wingSpan"
   },
   "children": [
    {
     "name": "Body",
     "shape": "ellipsoid",
     "segments": 20,
     "radii": [
      "$L * 0.095",
      "$L * 0.09",
      "$L * 0.22"
     ],
     "at": [
      0,
      "$by",
      0
     ]
    },
    {
     "name": "Neck",
     "shape": "cylinder",
     "radius": "$L * 0.035",
     "segments": 14,
     "height": "hypot(($by + $L * 0.2) - ($by + $L * 0.03), ($L * 0.3) - ($L * 0.15))",
     "at": [
      0,
      "(($by + $L * 0.03) + ($by + $L * 0.2)) / 2",
      "(($L * 0.15) + ($L * 0.3)) / 2"
     ],
     "rotate": [
      "deg(atan2(($L * 0.3) - ($L * 0.15), ($by + $L * 0.2) - ($by + $L * 0.03)))",
      0,
      0
     ]
    },
    {
     "name": "Head",
     "at": [
