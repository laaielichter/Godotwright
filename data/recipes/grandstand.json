{
 "version": 1,
 "name": "grandstand",
 "archetype": "building.grandstand",
 "description": "A covered grandstand along z: stepped concrete rows rising towards -x with a seat bench on each row, front and back walls, a roof on columns along the back and a railing at the front. The front (x = 0) faces +x: turn it so +x points at the track.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 30,
   "min": 10,
   "max": 120,
   "description": "Length of the stand along z in metres."
  },
  {
   "name": "rows",
   "type": "number",
   "default": 20,
   "min": 5,
   "max": 40,
   "description": "Number of rows; each is 0.85 m deep and 0.42 m higher."
  }
 ],
 "materials": {
  "seat": {
   "color": [
    0.85,
    0.25,
    0.02
   ],
   "roughness": 0.6
  },
  "roof_sheet": {
   "color": [
    0.8,
    0.81,
    0.82
   ],
   "metallic": 0.3,
   "roughness": 0.4,
   "doubleSided": true
  }
 },
 "nodes": [
  {
   "name": "Grandstand",
   "material": "concrete",
   "vars": {
    "L": "$length",
    "D": "$rows * 0.85 + 0.5",
    "F": "1.2",
    "T": "1.2 + $rows * 0.42"
   },
   "children": [
    {
     "name": "Wall_Front",
     "shape": "box",
     "size": [
      0.3,
      "$F",
      "$L"
     ],
     "at": [
      0.15,
      "$F / 2",
      0
     ]
    },
    {
     "name": "Row_{i}",
     "shape": "box",
     "size": [
      0.85,
      "$F + 0.42 * ($i + 1)",
      "$L"
     ],
     "at": [
      "0.3 + 0.425 + $i * 0.85",
      "($F + 0.42 * ($i + 1)) / 2",
      0
     ],
     "repeat": {
      "count": "$rows",
      "step": [
       0,
       0,
       0
      ]
     }
    },
    {
     "name": "Seat_{i}",
     "shape": "box",
     "material": "seat",
     "size": [
      0.38,
      0.42,
      "$L - 0.6"
     ],
     "at": [
      "0.3 + 0.62 + $i * 0.85",
      "$F + 0.42 * ($i + 1) + 0.21",
      0
     ],
     "repeat": {
      "count": "$rows",
      "step": [
       0,
       0,
       0
      ]
     }
    },
    {
     "name": "Wall_Back",
     "shape": "box",
     "size": [
      0.3,
      "$T + 1.2",
      "$L"
     ],
     "at": [
      "$D - 0.05",
      "($T + 1.2) / 2",
      0
     ]
    },
    {
     "name": "Column_{i}",
     "shape": "box",
     "material": "metal",
     "size": [
      0.3,
      "$T + 5 - ($T + 1.2)",
      0.3
     ],
     "at": [
      "$D - 0.05",
      "$T + 1.2 + ($T + 5 - ($T + 1.2)) / 2",
      "-$L / 2 + 0.3"
     ],
     "repeat": {
      "count": "floor(($L - 0.6) / 8) + 1",
      "step": [
       0,
       0,
       "($L - 0.6) / floor(($L - 0.6) / 8)"
      ]
     }
    },
    {
     "name": "Roof",
     "shape": "box",
     "material": "roof_sheet",
     "size": [
      "$D + 1.5",
      0.2,
      "$L + 1"
     ],
     "at": [
      "($D + 0.1) / 2",
      "$T + 5.1",
      0
     ]
    },
    {
     "name": "Railing",
     "shape": "box",
     "material": "metal",
     "size": [
      0.06,
      1.0,
      "$L"
     ],
     "at": [
      0.15,
      "$F + 0.5",
      0
     ]
    }
   ],
   "rotate": [
    0,
    180,
    0
   ]
  }
 ]
}
