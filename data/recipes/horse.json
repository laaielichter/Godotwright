{
 "version": 1,
 "name": "horse",
 "archetype": "creature.quadruped",
 "description": "A horse-shaped four-legged animal: a barrel body, a neck leaning forward, a head with ears, four legs with hooves and a hanging tail; every leg, the head and the tail a node with its pivot at the joint. Head towards +Z, hooves on y = 0.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 2.4,
   "min": 0.6,
   "max": 3.2,
   "description": "Length of the body in metres (a horse is about 2.4, a dog about 0.8)."
  },
  {
   "name": "legs",
   "type": "number",
   "default": 1.0,
   "min": 0.6,
   "max": 1.4,
   "description": "Leg length: 1 is a horse, lower is a pig or a dog."
  }
 ],
 "materials": {
  "coat": {
   "color": [
    0.42,
    0.27,
    0.16,
    1
   ],
   "metallic": 0,
   "roughness": 0.8
  },
  "hoof": {
   "color": [
    0.12,
    0.1,
    0.09,
    1
   ],
   "metallic": 0,
   "roughness": 0.6
  }
 },
 "nodes": [
  {
   "name": "Horse",
   "material": "coat",
   "vars": {
    "L": "$length",
    "lg": "$length * 0.34 * $legs",
    "by": "$length * 0.34 * $legs + $length * 0.14",
    "rl": "$length * 0.042",
    "lx": "$length * 0.09",
    "lz": "$length * 0.32"
   },
   "children": [
    {
     "name": "Body",
     "shape": "ellipsoid",
     "segments": 20,
     "radii": [
      "$L * 0.16",
      "$L * 0.18",
      "$L * 0.46"
     ],
     "at": [
      0,
      "$by",
      0
     ]
    },
    {
     "name": "Neck",
     "shape": "cylinder",
     "radius": "$L * 0.055",
     "segments": 14,
     "height": "hypot(($by + $L * 0.32) - ($by + $L * 0.06), ($L * 0.48) - ($L * 0.33))",
     "at": [
      0,
      "(($by + $L * 0.06) + ($by + $L * 0.32)) / 2",
      "(($L * 0.33) + ($L * 0.48)) / 2"
     ],
     "rotate": [
      "deg(atan2(($L * 0.48) - ($L * 0.33), ($by + $L * 0.32) - ($by + $L * 0.06)))",
      0,
      0
     ]
    },
    {
     "name": "Head",
     "at": [
      0,
      "$by + $L * 0.28",
      "$L * 0.48"
     ],
     "children": [
      {
       "name": "Muzzle",
       "shape": "ellipsoid",
       "segments": 14,
       "radii": [
        "$L * 0.05",
        "$L * 0.055",
        "$L * 0.14"
       ],
       "offset": [
        0,
        "$L * 0.055",
        "$L * 0.14"
       ]
      },
      {
       "name": "Ear_L",
       "shape": "lathe",
       "segments": 8,
       "at": [
        "$L * 0.03",
        "$L * 0.1",
        "$L * 0.03"
       ],
       "profile": [
        [
         "$L * 0.015",
         0
        ],
        [
         0,
         "$L * 0.06"
        ]
       ],
       "mirror": "Ear_R"
      }
     ]
    },
    {
     "name": "Leg_FL",
     "at": [
      "$lx + $rl * 2",
      "$lg + $L * 0.06",
      "$lz"
     ],
     "children": [
      {
       "name": "Bone",
       "shape": "cylinder",
       "radius": "$rl",
       "height": "$lg + $L * 0.06",
       "segments": 12,
       "offset": [
        "-($rl)",
        "-($lg + $L * 0.06) / 2",
        0
       ]
      },
      {
       "name": "Hoof",
       "shape": "cylinder",
       "material": "hoof",
       "radius": "$rl * 1.15",
       "height": "$L * 0.04",
       "segments": 12,
       "at": [
        "-$rl",
        "-$lg - $L * 0.04",
        0
       ]
      }
     ],
     "mirror": "Leg_FR"
    },
    {
     "name": "Leg_BL",
     "at": [
      "$lx + $rl * 2",
      "$lg + $L * 0.06",
      "-$lz"
     ],
     "children": [
      {
       "name": "Bone",
       "shape": "cylinder",
       "radius": "$rl",
       "height": "$lg + $L * 0.06",
       "segments": 12,
       "offset": [
        "-($rl)",
        "-($lg + $L * 0.06) / 2",
        0
       ]
      },
      {
       "name": "Hoof",
       "shape": "cylinder",
       "material": "hoof",
       "radius": "$rl * 1.15",
       "height": "$L * 0.04",
       "segments": 12,
       "at": [
        "-$rl",
        "-$lg - $L * 0.04",
        0
       ]
      }
     ],
     "mirror": "Leg_BR"
    },
    {
     "name": "Tail",
     "at": [
      0,
      "$by + $L * 0.1",
      "-$L * 0.43"
     ],
     "children": [
      {
       "name": "Hair",
       "shape": "cylinder",
       "radius": "$L * 0.035",
       "height": "$L * 0.3",
       "segments": 10,
       "offset": [
        0,
        "-$L * 0.15",
        "-$L * 0.035"
       ]
      }
     ]
    }
   ]
  }
 ]
}
