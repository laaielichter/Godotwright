{
 "version": 1,
 "name": "table",
 "archetype": "prop.table",
 "description": "A wooden table: a top, four legs and an apron frame under the top. Length is along z.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 1.4,
   "min": 0.6,
   "max": 3.0,
   "description": "Length of the top along z in metres."
  },
  {
   "name": "width",
   "type": "number",
   "default": 0.8,
   "min": 0.5,
   "max": 1.2,
   "description": "Width of the top along x in metres."
  },
  {
   "name": "height",
   "type": "number",
   "default": 0.75,
   "min": 0.7,
   "max": 0.8,
   "description": "Height of the top surface above the floor."
  }
 ],
 "nodes": [
  {
   "name": "Table",
   "material": "wood",
   "vars": {
    "L": "$length",
    "W": "$width",
    "H": "$height",
    "t": 0.04
   },
   "children": [
    {
     "name": "Top",
     "shape": "box",
     "size": [
      "$W",
      "$t",
      "$L"
     ],
     "at": [
      0,
      "$H - $t / 2",
      0
     ]
    },
    {
     "name": "Leg_FL",
     "shape": "box",
     "size": [
      0.07,
      "$H - $t",
      0.07
     ],
     "at": [
      "$W / 2 - 0.08",
      "($H - $t) / 2",
      "$L / 2 - 0.08"
     ],
     "mirror": "Leg_FR"
    },
    {
     "name": "Leg_BL",
     "shape": "box",
     "size": [
      0.07,
      "$H - $t",
      0.07
     ],
     "at": [
      "$W / 2 - 0.08",
      "($H - $t) / 2",
      "-$L / 2 + 0.08"
     ],
     "mirror": "Leg_BR"
    },
    {
     "name": "Apron_L",
     "shape": "box",
     "size": [
      0.025,
      0.09,
      "$L - 0.3"
     ],
     "at": [
      "$W / 2 - 0.08",
      "$H - $t - 0.045",
      0
     ],
     "mirror": "Apron_R"
    },
    {
     "name": "Apron_F",
     "shape": "box",
     "size": [
      "$W - 0.3",
      0.09,
      0.025
     ],
     "at": [
      0,
      "$H - $t - 0.045",
      "$L / 2 - 0.08"
     ]
    },
    {
     "name": "Apron_B",
     "shape": "box",
     "size": [
      "$W - 0.3",
      0.09,
      0.025
     ],
     "at": [
      0,
      "$H - $t - 0.045",
      "-($L / 2 - 0.08)"
     ]
    }
   ]
  }
 ]
}
