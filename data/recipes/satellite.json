{
 "version": 1,
 "name": "satellite",
 "archetype": "spacecraft.satellite",
 "description": "A communications satellite: a box-shaped bus with gold foil, a solar panel wing on each side that hinges at the bus, and a dish antenna facing +Z. It sits on y = 0, as on a launch adapter.",
 "params": [
  {
   "name": "busSize",
   "type": "number",
   "default": 2.2,
   "min": 1.0,
   "max": 4.0,
   "description": "Edge length of the bus in metres."
  },
  {
   "name": "panelSpan",
   "type": "number",
   "default": 6,
   "min": 2,
   "max": 16,
   "description": "Length of one solar panel wing in metres."
  }
 ],
 "materials": {
  "foil": {
   "color": [
    0.85,
    0.62,
    0.2,
    1
   ],
   "metallic": 0.9,
   "roughness": 0.3
  },
  "solar_cell": {
   "color": [
    0.05,
    0.08,
    0.25,
    1
   ],
   "metallic": 0.4,
   "roughness": 0.25
  }
 },
 "nodes": [
  {
   "name": "Satellite",
   "vars": {
    "S": "$busSize",
    "P": "$panelSpan"
   },
   "children": [
    {
     "name": "Bus",
     "shape": "box",
     "material": "foil",
     "size": [
      "$S",
      "$S",
      "$S"
     ],
     "anchor": "bottom"
    },
    {
     "name": "SolarPanel_L",
     "at": [
      "$S / 2",
      "$S / 2",
      0
     ],
     "mirror": "SolarPanel_R",
     "children": [
      {
       "name": "Yoke",
       "shape": "cylinder",
       "material": "metal",
       "axis": "x",
       "radius": 0.04,
       "height": "$S * 0.4",
       "segments": 8,
       "offset": [
        "$S * 0.2",
        0,
        0
       ]
      },
      {
       "name": "Cells",
       "shape": "box",
       "material": "solar_cell",
       "size": [
        "$P",
        "$S * 0.9",
        0.04
       ],
       "offset": [
        "$S * 0.4 + $P / 2",
        0,
        0
       ]
      }
     ]
    },
    {
     "name": "Antenna",
     "material": "metal",
     "at": [
      0,
      "$S * 0.55",
      "$S / 2"
     ],
     "children": [
      {
       "name": "Feed",
       "shape": "cylinder",
       "axis": "z",
       "radius": 0.05,
       "height": "$S * 0.35",
       "segments": 8,
       "offset": [
        0,
        0,
        "$S * 0.175"
       ]
      },
      {
       "name": "Dish",
       "shape": "lathe",
       "segments": 24,
       "rotate": [
        90,
        0,
        0
       ],
       "at": [
        0,
        0,
        "$S * 0.3"
       ],
       "profile": [
        [
         0,
         0
        ],
        [
         "$S * 0.2",
         "$S * 0.03"
        ],
        [
         "$S * 0.38",
         "$S * 0.12"
        ],
        [
         "$S * 0.38",
         "$S * 0.14"
        ],
        [
         0,
         "$S * 0.03"
        ]
       ]
      }
     ]
    }
   ]
  }
 ]
