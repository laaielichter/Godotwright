{
 "version": 1,
 "name": "conifer",
 "archetype": "plant.tree.conifer",
 "description": "A spruce-like conifer: a straight, tapering trunk with a few dead twigs low down, and a narrow cone of eleven whorls of drooping, needle-covered branches around a dark core, each whorl turned against the one below and closer together towards the pointed leader.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 12,
   "min": 4,
   "max": 40,
   "description": "Total height in metres."
  },
  {
   "name": "crownRadius",
   "type": "number",
   "default": 3,
   "min": 1.2,
   "max": 8,
   "description": "Radius of the lowest tier."
  },
  {
   "name": "trunkRadius",
   "type": "number",
   "default": 0.25,
   "min": 0.1,
   "max": 0.8,
   "description": "Trunk radius at the base."
  }
 ],
 "materials": {
  "conifer_bark": {
   "color": [
    0.17,
    0.12,
    0.09,
    1
   ],
   "metallic": 0,
   "roughness": 0.95,
   "texture": "bark"
  },
  "needles": {
   "color": [
    0.022,
    0.065,
    0.04,
    1
   ],
   "metallic": 0,
   "roughness": 0.85,
   "texture": "leaf"
  },
  "needles_tip": {
   "color": [
    0.04,
    0.1,
    0.05,
    1
   ],
   "metallic": 0,
   "roughness": 0.82,
   "texture": "leaf"
  }
 },
 "nodes": [
  {
   "name": "Conifer",
   "material": "conifer_bark",
   "vars": {
    "H": "$height",
    "R": "$crownRadius",
    "tr": "$trunkRadius",
    "y0": "max($height * 0.16, $crownRadius * 0.75)",
    "span": "$height * 0.95 - $y0"
   },
   "children": [
    {
     "name": "Trunk",
     "shape": "lathe",
     "segments": 14,
     "profile": [
      [
       "$tr * 1.55",
       0
      ],
      [
       "$tr * 1.15",
       "$H * 0.025"
      ],
      [
       "$tr",
       "$H * 0.08"
      ],
      [
       "$tr * 0.62",
       "$H * 0.45"
      ],
      [
       "$tr * 0.25",
       "$H * 0.8"
      ],
      [
       0,
       "$H * 0.97"
      ]
     ],
     "children": [
      {
       "name": "Snag_{i}",
       "shape": "tube",
       "segments": 5,
       "repeat": {
        "count": 4,
        "around": "y",
        "phase": 40
       },
       "at": [
        0,
        "$y0 * (0.45 + 0.13 * $i)",
        0
       ],
       "rotate": [
        0,
        "25 * sin($i * 2.1)",
        0
       ],
       "path": [
        [
         0,
         0,
         0
        ],
        [
         "$tr + $R * 0.12",
         "-$R * 0.02",
         0
        ],
        [
         "$tr + $R * 0.22",
         "-$R * 0.05",
         "$R * 0.02"
        ]
       ],
       "radii": [
        "$tr * 0.16",
        "$tr * 0.08",
        "$tr * 0.03"
       ]
      }
     ]
    },
    {
     "name": "Crown",
     "material": "needles",
     "children": [
      {
       "name": "Core",
       "shape": "lathe",
       "segments": 12,
       "profile": [
        [
         "$R * 0.08",
         "$y0 - $span * 0.03"
        ],
        [
         "$R * 0.5",
         "$y0 + $span * 0.06"
        ],
        [
         "$R * 0.28",
         "$y0 + $span * 0.6"
        ],
        [
         "$R * 0.06",
         "$y0 + $span * 0.93"
        ],
        [
         0,
         "$y0 + $span * 0.97"
        ]
       ]
      },
      {
       "name": "Tier_{i}",
       "repeat": {
        "count": 11,
        "step": [
         0,
         0,
         0
        ]
       },
       "at": [
        0,
        "$y0 + $span * pow($i / 11, 0.88)",
        0
       ],
       "children": [
        {
         "name": "Branch_{i}",
         "vars": {
          "k": "$i",
          "dy": "$span * (pow(($i + 1) / 11, 0.88) - pow($i / 11, 0.88))",
          "rt": "$R * max(0.1, pow(1 - 0.94 * $i / 11, 1.12))",
          "thick": "min($dy * 0.55, $R * 0.22, $rt * 0.4)",
          "wide": "max(1.15 * pi * $rt / (7 - floor($i / 4)), $rt * 0.2)",
          "droop": "12 + 16 * (1 - $i / 10)"
         },
         "repeat": {
          "count": "7 - floor($i / 4)",
          "around": "y",
          "phase": "$i * 29"
         },
         "rotate": [
          90,
          "12 * sin($i * 2.7 + $k * 1.3)",
          "-$droop - 7 * sin($i * 1.7 + $k * 0.9)"
         ],
         "shape": "ellipsoid",
         "material": "needles_tip",
         "segments": 12,
         "lumps": "0.38 * min(1, 2.6 * min($rt * 0.6, $wide, $thick) / max($rt * 0.6, $wide, $thick))",
         "seed": "$i * 17 + $k * 31 + 7",
         "at": [
          "$rt * 0.52",
          "$dy * 0.15 * sin($i * 2.9 + $k * 1.1)",
          0
         ],
         "radii": [
          "$rt * 0.6 * (0.88 + 0.24 * sin($i * 2.3 + $k))",
          "$wide",
          "$thick"
         ]
        }
       ]
      },
      {
       "name": "Leader",
       "shape": "ellipsoid",
       "material": "needles_tip",
       "segments": 10,
       "lumps": 0.2,
       "seed": 5,
       "at": [
        0,
        "$H * 0.925",
        0
       ],
       "radii": [
        "$R * 0.05",
        "$H * 0.075",
        "$R * 0.05"
       ]
      }
     ]
    }
   ]
  }
 ]
}
