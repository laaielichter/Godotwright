      ],
      [
       "$R * 0.38",
       "$H * 0.58"
      ],
      [
       "$R * 0.86",
       "$H * 0.34"
      ],
      [
       "$R * 0.55",
       "$H * 0.34"
      ],
      [
       "$R",
       "$H * 0.08"
