   "type": "number",
   "default": 3,
   "min": 1.2,
   "max": 8,
   "description": "Radius of the lowest tier."
  },
  {
   "name": "trunkRadius",
   "type": "number",
   "default": 0.25,
   "min": 0.1,
   "max": 0.8,
   "description": "Trunk radius at the base."
  }
 ],
