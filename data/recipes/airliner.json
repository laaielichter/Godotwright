{
 "version": 1,
 "name": "airliner",
 "archetype": "aircraft.fixed-wing.airliner",
 "description": "A twin-engine passenger jet: round fuselage, swept tapered wings with dihedral, engines under the wings, tailplane, fin, cockpit glass and landing gear.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 38,
   "min": 20,
   "max": 70,
   "description": "Fuselage length in metres (an A320 is about 37.6)."
  },
  {
   "name": "diameter",
   "type": "number",
   "default": 4.0,
   "min": 2.5,
   "max": 7.0,
   "description": "Fuselage diameter."
  },
  {
   "name": "wingSpan",
   "type": "number",
   "default": 35.8,
   "min": 20,
   "max": 65,
   "description": "Wingspan, tip to tip."
  }
 ],
 "materials": {
  "airliner_white": {
   "color": [
    0.9,
    0.91,
    0.93
   ],
   "metallic": 0.25,
   "roughness": 0.3
  },
  "airliner_tail": {
   "color": [
    0.1,
    0.25,
    0.55
   ],
   "metallic": 0.25,
   "roughness": 0.3
  },
  "tyre": {
   "color": [
    0.03,
    0.03,
    0.03
   ],
   "metallic": 0,
   "roughness": 0.9
  }
 },
 "nodes": [
  {
   "name": "Airliner",
   "material": "airliner_white",
   "vars": {
    "c": "$diameter * 0.95",
    "h": "$wingSpan / 2 - $diameter * 0.35",
    "rc": "$length * 0.17",
    "tc": "$length * 0.047",
    "zw": "$length * 0.04",
    "leg": "$diameter * 0.5"
   },
   "children": [
    {
     "name": "Fuselage",
     "shape": "loft",
     "sections": [
      {
       "z": "$length * 0.5",
       "superellipse": {
        "width": "$diameter * 0.34",
        "height": "$diameter * 0.34",
        "n": 2,
        "count": 32,
        "cy": "$c - $diameter * 0.12"
       }
      },
      {
       "z": "$length * 0.44",
       "superellipse": {
        "width": "$diameter * 0.85",
        "height": "$diameter * 0.85",
        "n": 2,
        "count": 32,
        "cy": "$c - $diameter * 0.04"
       }
      },
      {
       "z": "$length * 0.36",
       "superellipse": {
        "width": "$diameter",
        "height": "$diameter",
        "n": 2,
        "count": 32,
        "cy": "$c"
       }
      },
      {
       "z": "-$length * 0.2",
       "superellipse": {
        "width": "$diameter",
        "height": "$diameter",
        "n": 2,
        "count": 32,
        "cy": "$c"
       }
      },
      {
       "z": "-$length * 0.36",
       "superellipse": {
        "width": "$diameter * 0.75",
        "height": "$diameter * 0.7",
        "n": 2,
        "count": 32,
        "cy": "$c + $diameter * 0.08"
       }
      },
      {
       "z": "-$length * 0.5",
       "superellipse": {
        "width": "$diameter * 0.15",
        "height": "$diameter * 0.2",
        "n": 2,
        "count": 32,
        "cy": "$c + $diameter * 0.22"
       }
      }
     ]
    },
    {
     "name": "Cockpit",
     "shape": "ellipsoid",
     "material": "glass",
     "radii": [
      "$diameter * 0.34",
      "$diameter * 0.17",
      "$length * 0.045"
     ],
     "at": [
      0,
      "$c + $diameter * 0.27",
      "$length * 0.425"
     ]
    },
    {
     "name": "WingLeft",
     "at": [
      "$diameter * 0.35",
      "$c - $diameter * 0.28",
      "$zw"
     ],
     "rotate": [
      0,
      90,
      5
     ],
     "mirror": "WingRight",
     "children": [
      {
       "name": "Skin",
       "shape": "loft",
       "sections": [
        {
         "z": 0,
         "superellipse": {
          "width": "$rc",
          "height": "$rc * 0.13",
          "n": 2.5,
          "count": 24,
          "cy": 0
         }
        },
        {
         "z": "$h * 0.4",
         "superellipse": {
          "width": "$rc * 0.6",
          "height": "$rc * 0.07",
          "n": 2.5,
          "count": 24,
          "cy": 0,
          "cx": "$h * 0.4 * 0.49 + ($rc - $rc * 0.6) * 0.25"
         }
        },
        {
         "z": "$h",
         "superellipse": {
          "width": "$tc",
          "height": "$tc * 0.1",
          "n": 2.5,
          "count": 24,
          "cy": 0,
          "cx": "$h * 0.49 + ($rc - $tc) * 0.25"
         }
        }
       ]
      }
     ]
    },
    {
     "name": "Engine_L",
     "shape": "lathe",
     "segments": 32,
     "rotate": [
      90,
      0,
      0
     ],
     "material": "metal",
     "profile": [
      [
       0,
       "-$length * 0.045"
      ],
      [
       "$diameter * 0.27",
       "-$length * 0.045"
      ],
      [
       "$diameter * 0.3",
       "-$length * 0.03"
      ],
      [
       "$diameter * 0.31",
       0
      ],
      [
       "$diameter * 0.26",
       "$length * 0.04"
      ],
      [
       "$diameter * 0.1",
       "$length * 0.05"
      ]
     ],
     "at": [
      "$diameter * 0.35 + $h * 0.35",
      "$c - $diameter * 0.59 + $h * 0.35 * 0.087 + 0.1",
      "$zw + $length * 0.06"
     ],
     "mirror": "Engine_R"
    },
    {
     "name": "Stabilizer_L",
     "at": [
      "$diameter * 0.1",
      "$c + $diameter * 0.15",
      "-$length * 0.43"
     ],
     "rotate": [
      0,
      90,
      3
     ],
     "mirror": "Stabilizer_R",
     "children": [
      {
       "name": "Skin",
       "shape": "loft",
       "sections": [
        {
         "z": 0,
         "superellipse": {
          "width": "$length * 0.085",
          "height": "$length * 0.008",
          "n": 2.5,
          "count": 24,
          "cy": 0
         }
        },
        {
         "z": "$wingSpan * 0.14",
         "superellipse": {
          "width": "$length * 0.03",
          "height": "$length * 0.004",
          "n": 2.5,
          "count": 24,
          "cy": 0,
          "cx": "$wingSpan * 0.14 * 0.5"
         }
        }
       ]
      }
     ]
    },
    {
     "name": "Fin",
     "material": "airliner_tail",
     "shape": "loft",
     "sections": [
      {
       "z": "-$length * 0.3",
       "superellipse": {
        "width": "$diameter * 0.07",
        "height": "$diameter * 0.5",
        "n": 2.5,
        "count": 16,
        "cy": "$c + $diameter * 0.65"
       }
      },
      {
       "z": "-$length * 0.36",
       "superellipse": {
        "width": "$diameter * 0.07",
        "height": "$diameter",
        "n": 2.5,
        "count": 16,
        "cy": "$c + $diameter * 0.9"
       }
      },
      {
       "z": "-$length * 0.42",
       "superellipse": {
        "width": "$diameter * 0.06",
        "height": "$diameter * 1.4",
        "n": 2.5,
        "count": 16,
        "cy": "$c + $diameter * 1.1"
       }
      },
      {
       "z": "-$length * 0.465",
       "superellipse": {
        "width": "$diameter * 0.05",
        "height": "$diameter * 1.6",
        "n": 2.5,
        "count": 16,
        "cy": "$c + $diameter * 1.2"
       }
      }
     ]
    },
    {
     "name": "LandingGear_Nose",
     "material": "metal",
     "at": [
      0,
      "$c - $diameter * 0.45",
      "$length * 0.36"
     ],
     "children": [
      {
       "name": "Leg",
       "shape": "box",
       "size": [
        0.12,
        "$leg - 0.4",
        0.12
       ],
       "at": [
        0,
        "-($leg - 0.4) / 2",
        0
       ]
      },
      {
       "name": "Foot_L",
       "shape": "cylinder",
       "material": "tyre",
       "axis": "x",
       "radius": 0.4,
       "height": 0.28,
       "at": [
        0.22,
        "-($leg - 0.4)",
        0
       ],
       "mirror": "Foot_R"
      }
     ]
    },
    {
     "name": "LandingGear_Main_L",
     "material": "metal",
     "at": [
      "$diameter * 0.3",
      "$c - $diameter * 0.45",
      "$zw + $length * 0.02"
     ],
     "mirror": "LandingGear_Main_R",
     "children": [
      {
       "name": "Leg",
       "shape": "box",
       "size": [
        0.16,
        "$leg - 0.55",
        0.16
       ],
       "at": [
        0,
        "-($leg - 0.55) / 2",
        0
       ]
      },
      {
       "name": "Foot",
       "shape": "cylinder",
       "material": "tyre",
       "axis": "x",
       "radius": 0.55,
       "height": 0.4,
       "at": [
        0,
        "-($leg - 0.55)",
        0.55
       ],
       "repeat": {
        "count": 2,
        "step": [
         0,
         0,
         -1.1
        ]
       }
      }
     ]
    }
   ]
  }
 ]
}
