{
 "version": 1,
 "name": "bush",
 "archetype": "plant.bush",
 "description": "A shrub: a dome of overlapping, lumpy leaf masses in two greens around a central core, a ring of masses round the outside (their number sets how full it is), a smaller ring above it and a few on top, over short woody stems; it stands on y = 0.",
 "params": [
  {
   "name": "width",
   "type": "number",
   "default": 1.6,
   "min": 0.5,
   "max": 3,
   "description": "Diameter of the bush in metres."
  },
  {
   "name": "height",
   "type": "number",
   "default": 1.1,
   "min": 0.5,
   "max": 3,
   "description": "Height of the bush in metres."
  },
  {
   "name": "masses",
   "type": "integer",
   "default": 6,
   "min": 3,
   "max": 10,
   "description": "Number of leaf masses around the centre."
  }
 ],
 "materials": {
  "bush_leaf": {
   "color": [
    0.045,
    0.12,
    0.03,
    1
   ],
   "metallic": 0,
   "roughness": 0.8,
   "texture": "leaf"
  },
  "bush_leaf_sun": {
   "color": [
    0.08,
    0.18,
    0.035,
    1
   ],
   "metallic": 0,
   "roughness": 0.78,
   "texture": "leaf"
  },
  "bush_wood": {
   "color": [
    0.16,
    0.11,
    0.07,
    1
   ],
   "metallic": 0,
   "roughness": 0.95,
   "texture": "bark"
  }
 },
 "nodes": [
  {
   "name": "Bush",
   "material": "bush_leaf",
   "vars": {
    "w": "$width",
    "h": "$height",
    "lp": "0.32 * min(1, 1.6 * min($width, 2 * $height) / max($width, 2 * $height))"
   },
   "children": [
    {
     "name": "Stem_{i}",
     "shape": "tube",
     "material": "bush_wood",
     "segments": 6,
     "repeat": {
      "count": 3,
      "around": "y",
      "phase": 30
     },
     "path": [
      [
       0,
       0,
       0
      ],
      [
       0,
       "$h * 0.12",
       0
      ],
      [
       "$w * 0.08",
       "$h * 0.3",
       "$w * 0.02"
      ],
      [
       "$w * 0.16",
       "$h * 0.45",
       0
      ]
     ],
     "radii": [
      "$w * 0.035",
      "$w * 0.03",
      "$w * 0.022",
      "$w * 0.012"
     ]
    },
    {
     "name": "Core",
     "shape": "ellipsoid",
     "segments": 24,
     "lumps": "$lp",
     "seed": 23,
     "at": [
      0,
      "$h * 0.56",
      0
     ],
     "rotate": [
      90,
      127,
      0
     ],
     "radii": [
      "$w * 0.32",
      "$w * 0.32",
      "$h * 0.43"
     ]
    },
    {
     "name": "Mass_{i}",
     "shape": "ellipsoid",
     "segments": 18,
     "lumps": "$lp",
     "seed": "$i * 7 + 2",
     "material": "bush_leaf",
     "repeat": {
      "count": "$masses",
      "around": "y",
      "phase": 11
     },
     "at": [
      "$w * (0.25 + 0.05 * sin($i * 3.1)) * min(1.1, 6 / $masses + 0.1)",
      "$h * (0.33 + 0.06 * (0.5 + 0.5 * cos($i * 1.61 + 1.2))) * (0.88 + 0.24 * (0.5 + 0.5 * sin($i * 2.17 + 0.4)))",
      0
     ],
     "rotate": [
      90,
      "127 - (11 + $i * 360 / $masses)",
      0
     ],
     "radii": [
      "$w * 0.24 * (0.88 + 0.24 * (0.5 + 0.5 * sin($i * 2.17 + 0.4)))",
      "$w * 0.23 * (0.88 + 0.24 * (0.5 + 0.5 * sin($i * 2.17 + 0.4)))",
      "$h * 0.26 * (0.88 + 0.24 * (0.5 + 0.5 * sin($i * 2.17 + 0.4)))"
     ]
    },
    {
     "name": "Upper_{i}",
     "shape": "ellipsoid",
     "segments": 16,
     "lumps": "$lp",
     "seed": "$i * 5 + 41",
     "material": "bush_leaf_sun",
     "repeat": {
      "count": "max(3, $masses - 2)",
      "around": "y",
      "phase": 47
     },
     "at": [
      "$w * 0.2",
      "$h * (0.55 + 0.08 * (0.5 + 0.5 * cos($i * 1.61 + 1.2)))",
      0
     ],
     "rotate": [
      90,
      "127 - (47 + $i * 360 / max(3, $masses - 2))",
      0
     ],
     "radii": [
      "$w * 0.19 * (0.88 + 0.24 * (0.5 + 0.5 * sin($i * 2.17 + 0.4)))",
      "$w * 0.18 * (0.88 + 0.24 * (0.5 + 0.5 * sin($i * 2.17 + 0.4)))",
      "$h * 0.21 * (0.88 + 0.24 * (0.5 + 0.5 * sin($i * 2.17 + 0.4)))"
     ]
    },
    {
     "name": "Top_{i}",
     "shape": "ellipsoid",
     "segments": 18,
     "lumps": "$lp",
     "seed": "$i * 13 + 5",
     "material": "bush_leaf_sun",
     "repeat": {
      "count": 3,
      "around": "y",
      "phase": 70
     },
     "at": [
      "$w * 0.12",
      "$h * 0.76",
      0
     ],
     "rotate": [
      90,
      "127 - (70 + $i * 120)",
      0
     ],
     "radii": [
      "$w * 0.18",
      "$w * 0.18",
      "$h * 0.22"
     ]
    }
   ]
  }
 ]
}
