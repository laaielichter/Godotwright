{
 "version": 1,
 "name": "castle",
 "archetype": "building.fortification",
 "description": "A square stone castle: four curtain walls with battlements, a round tower at each corner with a conical roof, a gatehouse with a gate and a drawbridge in the +Z face, and a keep against the back wall.",
 "params": [
  {
   "name": "size",
   "type": "number",
   "default": 50,
   "min": 30,
   "max": 120,
   "description": "Length of a side between the corner towers, in metres."
  },
  {
   "name": "wallHeight",
   "type": "number",
   "default": 10,
   "min": 6,
   "max": 15,
   "description": "Height of the curtain walls in metres."
  }
 ],
 "materials": {
  "castle_stone": {
   "color": [
    0.55,
    0.53,
    0.5,
    1
   ],
   "metallic": 0,
   "roughness": 0.92
  }
 },
 "nodes": [
  {
   "name": "Castle",
   "material": "castle_stone",
   "vars": {
    "S": "$size",
    "h": "$size / 2",
    "H": "$wallHeight",
    "t": 2.5,
    "g": 8,
    "rT": "max(3, $size * 0.07)",
    "HT": "$wallHeight * 1.5"
   },
   "children": [
    {
     "name": "Wall_B",
     "shape": "box",
     "size": [
      "$S",
      "$H",
      "$t"
     ],
     "at": [
      0,
      "$H / 2",
      "-$h"
     ]
    },
    {
     "name": "Wall_L",
     "shape": "box",
     "size": [
      "$t",
      "$H",
      "$S"
     ],
     "at": [
      "$h",
      "$H / 2",
      0
     ],
     "mirror": "Wall_R"
    },
    {
     "name": "Wall_FL",
     "shape": "box",
     "size": [
      "$h - $g / 2",
      "$H",
      "$t"
     ],
     "at": [
      "($h + $g / 2) / 2",
      "$H / 2",
      "$h"
     ],
     "mirror": "Wall_FR"
    },
    {
     "name": "Battlements_B",
     "children": [
      {
       "name": "Merlon_{i}",
       "shape": "box",
       "size": [
        1,
        1.2,
        "$t"
       ],
       "at": [
        "-$h + 1",
        "$H + 0.6",
        "-$h"
       ],
       "repeat": {
        "count": "floor($S / 2)",
        "step": [
         2,
         0,
         0
        ]
       }
      }
     ]
    },
    {
     "name": "Battlements_L",
     "children": [
      {
       "name": "Merlon_{i}",
       "shape": "box",
       "size": [
        "$t",
        1.2,
        1
       ],
       "at": [
        "$h",
        "$H + 0.6",
        "-$h + 1"
       ],
       "repeat": {
        "count": "floor($S / 2)",
        "step": [
         0,
         0,
         2
        ]
       }
      }
     ],
     "mirror": "Battlements_R"
    },
    {
     "name": "Battlements_FL",
     "children": [
      {
       "name": "Merlon_{i}",
       "shape": "box",
       "size": [
        1,
        1.2,
        "$t"
       ],
       "at": [
        "$g / 2 + 3",
        "$H + 0.6",
        "$h"
       ],
       "repeat": {
        "count": "floor(($h - $g / 2 - 3) / 2)",
        "step": [
         2,
         0,
         0
        ]
       }
      }
     ],
     "mirror": "Battlements_FR"
    },
    {
     "name": "Tower_FL",
     "at": [
      "$h",
      0,
      "$h"
     ],
     "mirror": "Tower_FR",
     "children": [
      {
       "name": "Drum",
       "shape": "lathe",
       "segments": 24,
       "profile": [
        [
         "$rT",
         0
        ],
        [
         "$rT",
         "$HT"
        ],
        [
         "$rT * 1.12",
         "$HT"
        ],
        [
         "$rT * 1.12",
         "$HT + 1.2"
        ],
        [
         0,
         "$HT + 1.2"
        ]
       ]
      },
      {
       "name": "Roof",
       "shape": "lathe",
       "material": "roof_slate",
       "segments": 24,
       "at": [
        0,
        "$HT + 1.2",
        0
       ],
       "profile": [
        [
         "$rT * 1.18",
         0
        ],
        [
         0,
         "$rT * 1.7"
        ]
       ]
      }
     ]
    },
    {
     "name": "Tower_BL",
     "at": [
      "$h",
      0,
      "-$h"
     ],
     "mirror": "Tower_BR",
     "children": [
      {
       "name": "Drum",
       "shape": "lathe",
       "segments": 24,
       "profile": [
        [
         "$rT",
         0
        ],
        [
         "$rT",
         "$HT"
        ],
        [
         "$rT * 1.12",
         "$HT"
        ],
        [
         "$rT * 1.12",
         "$HT + 1.2"
        ],
        [
         0,
         "$HT + 1.2"
        ]
       ]
      },
      {
       "name": "Roof",
       "shape": "lathe",
       "material": "roof_slate",
       "segments": 24,
       "at": [
        0,
        "$HT + 1.2",
        0
       ],
       "profile": [
        [
         "$rT * 1.18",
         0
        ],
        [
         0,
         "$rT * 1.7"
        ]
       ]
      }
     ]
    },
    {
     "name": "Gatehouse",
     "shape": "box",
     "size": [
      "$g + 6",
      "$H * 1.25",
      "$t + 4"
     ],
     "at": [
      0,
      "$H * 0.625",
      "$h"
     ]
    },
    {
     "name": "Gate",
     "shape": "box",
     "material": "wood",
     "size": [
      "$g * 0.5",
      "$H * 0.55",
      0.3
     ],
     "at": [
      0,
      "$H * 0.275",
      "$h + ($t + 4) / 2 + 0.15"
     ]
    },
    {
     "name": "Drawbridge",
     "at": [
      0,
      0,
      "$h + ($t + 4) / 2 + 0.3"
     ],
     "children": [
      {
       "name": "Deck",
       "shape": "box",
       "material": "wood",
       "size": [
        "$g * 0.5",
        0.3,
        "$H * 0.55"
       ],
       "offset": [
        0,
        0.15,
        "$H * 0.275"
       ]
      }
     ]
    },
    {
     "name": "Keep",
     "children": [
      {
       "name": "Block",
       "shape": "box",
       "size": [
        "$S * 0.3",
        "$H * 1.8",
        "$S * 0.3"
       ],
       "at": [
        0,
        "$H * 0.9",
        "-$h + $t / 2 + $S * 0.15"
       ]
      },
      {
       "name": "Roof",
       "shape": "roof",
       "material": "roof_slate",
       "x0": "-$S * 0.16",
       "x1": "$S * 0.16",
       "z0": "-$h + $t / 2 - $S * 0.01",
       "z1": "-$h + $t / 2 + $S * 0.31",
       "y": "$H * 1.8",
       "rise": "$S * 0.08",
       "kind": "hip"
      }
     ]
    }
   ]
  }
 ]
}
